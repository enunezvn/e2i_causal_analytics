# Production environment configuration
# This file is loaded during Vite production builds

# Enable CopilotKit AI Chat widget in production
VITE_COPILOT_ENABLED=true

# API URL for production (nginx proxies /api to port 8000)
# Use relative URL - works behind nginx HTTPS proxy
VITE_API_URL=/api

# Supabase (VITE_ prefix required for Vite client-side access)
#
# VITE_SUPABASE_URL is INTENTIONALLY EMPTY (do not "fix" it):
# src/config/env.ts treats an empty value as unset and defaults to
# window.location.origin at runtime, so the supabase-js client targets the
# same origin the app is served from (e.g. https://eznomics.site). Host nginx
# (docker/nginx/host-nginx.conf) proxies the paths supabase-js v2 appends -
# /auth/v1, /rest/v1, /realtime/v1, /storage/v1 - to the self-hosted Kong on
# 127.0.0.1:54321. Designed in commit 373f62d7 ("proxy Supabase through nginx
# to resolve mixed-content login failure").
#
# Note: this empty mode-specific value also SHADOWS any VITE_SUPABASE_URL in a
# local untracked frontend/.env during `vite build` (verified on vite 6.4.1),
# so dev values like https://localhost:8443 cannot leak into prod bundles.
# The frontend Dockerfile additionally fails the image build if localhost:8443
# is found in the emitted assets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzY5MzUzMDYzLCJleHAiOjIwODQ3MTMwNjN9.HB_ImkVYor5f4xBYK9kLRTfYW1aq3p-NQOurBIYWYC8
