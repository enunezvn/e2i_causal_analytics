# Feast feature_store.yaml is rendered from feature_store.yaml.tmpl at runtime
# (see docker/feast/entrypoint.sh and scripts/feast_render_config.sh).
# It contains real secrets when rendered; never commit.
feature_repo/feature_store.yaml

# Feast registry blobs — `*.db` covers SQLite today, but Feast supports
# other registry backends (json, file-based) too. Glob at the path level
# so we're robust to future filename changes. (3B-M-1)
feature_repo/data/registry.*

# Temporary
tmp/
temp/
*.tmp

# Archive
archive/

# Documentation - ignore generated/local-only subdirectories
docs/Archive/
# Use the wildcard form (NOT a bare dir path) so per-file negations below
# can take effect: gitignore can't re-include files inside an ignored dir.
docs/results/*
# Block 0 + PR #2 baseline + verification docs are tracked exceptions
!docs/results/tier0_remediation_baseline_*.md
!docs/results/tier0_evaluation_current_state_*.md
!docs/results/feast_infra_*.md
# Phase 1 W4 days 2-5 multi-disease validation outcomes (synthetic_v2 shard 09 §F closure)
!docs/results/phase1_w4_days25_*.md
!docs/results/phase1_w4_days25_*.json
# Phase 4b CSU converter masking remediation evidence (per §8.3 of csu_field_audit.md)
!docs/results/csu_post_lineage_audit_*.md
# Phase 6 training-serving skew regression-guard evidence (R6)
!docs/results/training_serving_skew_*.md
# Optum cohort re-validation evidence (close-out arc regression detection)
!docs/results/optum_initiation_revalidation_*.md
# Optum vs synthetic cohort forensics (LOINC re-mapping authority; cited by OPTUM_CONVERSION.md + convert_optum_rwd.py)
!docs/results/tier0_cohort_comparison_*.md
# Phase 5.2 dry-run scale-machinery evidence (synthetic boundaries)
!docs/results/phase5p2_scale_machinery_*.md
# Gate N3 methodology sign-off templates + dated artifacts (Tier 1A governance)
!docs/results/optum_methodology_signoff_*.md
!docs/results/optum_methodology_rejection_*.md
# v5 Gate A1 harness production-parity re-run evidence
!docs/results/g2_harness_a1_parity_run_*.md
# v5 Gate B1 calibration validation evidence
!docs/results/v5_b1_calibration_*.md

