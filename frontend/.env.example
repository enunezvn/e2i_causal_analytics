# Frontend environment contract (Vite) — #23
#
# ⚠️  ONLY `VITE_*` variables belong in this file.
#
# Vite bundles every `VITE_*` variable into the CLIENT bundle, which ships to
# the browser. Therefore:
#   * NEVER put backend secrets here (no service-role keys, LLM API keys,
#     database URLs, infra tokens). They would either be embedded in the public
#     JS bundle (if prefixed VITE_) or sit uselessly in a file the frontend
#     never reads (if not). Backend secrets live in the BACKEND `.env`, never here.
#   * Only the anon/publishable Supabase key is safe to expose (it is designed
#     to be public and is gated by Row-Level Security).
#
# File precedence:
#   * `.env` / `.env.local`            — gitignored, your LOCAL dev values.
#   * `.env.production`                — TRACKED in git; build-time defaults for the
#                                        production build. Safe because every value
#                                        here is a public `VITE_*` (no secrets).
#   * `.env.production.local`          — gitignored, untracked per-deploy overrides.
# Copy this file to `.env` for local dev. Do NOT commit secrets to ANY of them.

# Backend API base URL (e.g. https://eznomics.site or http://localhost:8000).
# At the public origin this is the same host; the app also falls back to
# window.location.origin at runtime.
VITE_API_URL=

# Supabase project URL + anon (publishable) key. The anon key is PUBLIC by
# design — do NOT use the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flags / build metadata.
VITE_COPILOT_ENABLED=false
VITE_APP_VERSION=

# Optional deploy-time default model id for the AI Agent Insights page
# (overridable per-request via URL param). Leave blank to use the app default.
VITE_DEFAULT_MODEL_ID=

# Dev diagnostics: enable verbose client logging. MUST be false/unset in prod.
VITE_DEBUG=false

# Dev-only: enable the Mock Service Worker layer. MUST be false/unset in
# production builds (the prod Docker build also guards against shipping MSW).
VITE_MSW_ENABLED=false
