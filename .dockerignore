# =============================================================================
# Docker Build Context Exclusions
# =============================================================================
# Reduces build context size and speeds up Docker builds
# =============================================================================

# -----------------------------------------------------------------------------
# Version Control
# -----------------------------------------------------------------------------
.git
.gitignore
.gitattributes
.github

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.manifest
*.spec

# Virtual environments
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.cache

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# -----------------------------------------------------------------------------
# IDEs and Editors
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
.DS_Store
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Documentation
# -----------------------------------------------------------------------------
*.md
!README.md
docs/
*.txt
!requirements.txt
!requirements.lock

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose*.yml
!docker-compose.yml
!docker-compose.dev.yml
Dockerfile*
!Dockerfile
.dockerignore

# -----------------------------------------------------------------------------
# Data & Artifacts
# -----------------------------------------------------------------------------
data/
# ...except the committed KG Layer-2 caches — re-included below, after `*.json`.
*.csv
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
*.json
!pyproject.toml
!package.json
!package-lock.json
!tsconfig.json
!config/**/*.json
# The committed KG Layer-2 caches (#1607). ~72 KB build-time INPUTS, not runtime
# artifacts: src/data/kg/activation.py binds a cohort's feature manifest to one
# of these files and the adaptive-validity node loads it on the hot path. The
# blanket `data/` exclusion above made the whole KG layer inert IN THE IMAGE
# while the artifact sat committed in git — the #600 shape again, where a
# missing artifact presents as "the KG had nothing to say" rather than as a
# missing file.
#
# Placement is load-bearing: this must sit AFTER `*.json` and after the `*.md`
# rule near the top, because .dockerignore is last-match-wins — an un-ignore
# beside `data/` would be silently undone by both. Same reason
# !config/**/*.json lives here. Guarded by
# tests/unit/test_data/test_kg/test_kg_cache_packaging.py.
!data/kg_cache/
!data/kg_cache/**

# ML artifacts
models/
checkpoints/
experiments/
mlruns/
outputs/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
*.out

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
# .dockerignore patterns are ROOTED: the entries above exclude only repo-root
# env files, NOT frontend/.env. The frontend Dockerfile builder COPYs
# frontend/ wholesale, so an untracked local frontend/.env (which carries dev
# values like VITE_SUPABASE_URL=https://localhost:8443) would otherwise enter
# the build context. frontend/.env.production is tracked and REQUIRED by the
# production vite build - keep it included.
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/.env.development
*.pem
*.key
*.crt
secrets/

# -----------------------------------------------------------------------------
# Temporary Files
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp

# -----------------------------------------------------------------------------
# OS Files
# -----------------------------------------------------------------------------
Thumbs.db
.DS_Store
desktop.ini

# -----------------------------------------------------------------------------
# Node.js (Frontend)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Build outputs
# -----------------------------------------------------------------------------
dist/
build/
*.whl
