# Semgrep path-based ignores — local-dev noise reduction.
# CI uses --severity ERROR which already filters out WARNING-level findings;
# this file mirrors that ergonomically for `semgrep scan` invocations
# without --severity flags (e.g., editor integrations).

# nginx config files generate WARNING-level findings (request-host,
# h2c-smuggling, header-redefinition) on standard internal-proxy patterns.
# Reviewed manually; not actionable.
docker/nginx/*.conf
docker/frontend/nginx.conf

# scripts/seed_falkordb_init.py is a docker-compose init container.
# Its `subprocess.run` call uses validated env vars + list args (no shell),
# so OS-command injection is structurally impossible. Semgrep's taint
# analyzer can't see _validate_host/_validate_port as sanitizers, so it
# keeps flagging the call. Suppress this single file rather than dilute
# the rule for the rest of the codebase.
scripts/seed_falkordb_init.py

# Ignore vendored/build artifacts and worktrees.
.venv/
node_modules/
.worktrees/
frontend/dist/
frontend/build/
